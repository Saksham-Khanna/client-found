PORT=4000
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Neon (Postgres) pooled connection string. Create a project at neon.tech,
# copy the "Pooled connection" string and paste it here.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# Allow CORS from this origin (dev only; same-origin in prod)
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings for inquiry notification emails.
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The address that sends the mail and receives replies.
SMTP_USER=khanna.saksham2918@gmail.com
SMTP_PASS=replace-with-gmail-app-password
SMTP_FROM=khanna.saksham2918@gmail.com
